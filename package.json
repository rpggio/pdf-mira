{
  "name": "pdf-mira",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "PDF Argument Reader \u2014 a PDF viewer with a synchronized MIRA argument graph.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "help:shots": "node scripts/help-shots.mjs",
    "verify:ingestion": "node scripts/verify-ingestion.mjs",
    "verify:live": "node scripts/verify-live-ingestion.mjs",
    "dev:mock": "node scripts/mock-reader.mjs",
    "verify:pdf-viewer": "node --test modules/pdf-viewer/browser/compat.ts",
    "verify:mock": "node scripts/verify-mock.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.1",
    "fast-xml-parser": "^5.12.0",
    "mira-extraction": "github:MIRA-science/MIRA-extraction#8d98e3579cd86723c167bab89d49bb4c48401fbc",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
