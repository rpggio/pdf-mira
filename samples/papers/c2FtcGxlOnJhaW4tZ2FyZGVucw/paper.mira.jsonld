    {
      "@id": "q1-quote-0",
      "@type": "Item",
      "content": "does planting reduce the water that leaves a plot during a storm of fixed size"
    },
    {
      "@id": "q2-quote-0",
      "@type": "Item",
      "content": "does the soil moisture before the storm change the answer"
    },
    {
      "@id": "q3-quote-0",
      "@type": "Item",
      "content": "can a small plot experiment say anything about the drainage of a whole street"
    },
    {
      "@id": "q4-quote-0",
      "@type": "Item",
      "content": "What happens to neighborhood-scale flooding after several years of planting?"
    },
    {
      "@id": "c1-quote-0",
      "@type": "Item",
      "content": "Planted plots released less runoff than bare plots"
    },
    {
      "@id": "c2-quote-0",
      "@type": "Item",
      "content": "the largest differences occurred where the soil was dry before the test"
    },
    {
      "@id": "c3-quote-0",
      "@type": "Item",
      "content": "Deep roots and dry soil can help a plot absorb rainfall."
    },
    {
      "@id": "c4-quote-0",
      "@type": "Item",
      "content": "the advantage disappeared as the soil approached saturation"
    },
    {
      "@id": "c5-quote-0",
      "@type": "Item",
      "content": "a garden saturated by a long rainy week will help little during the next storm"
    },
    {
      "@id": "c6-quote-0",
      "@type": "Item",
      "content": "Whether rain gardens reduce flooding across a neighborhood remains an open question for larger and longer trials."
    },
    {
      "@id": "c7-quote-0",
      "@type": "Item",
      "content": "A two-meter plot has no neighbors upslope and no pipes beneath it."
    },
    {
      "@id": "c8-quote-0",
      "@type": "Item",
      "content": "we regard it as a prediction for future work, not a finding"
    },
    {
      "@id": "c9-quote-0",
      "@type": "Item",
      "content": "Leaf interception probably played a small part"
    },
    {
      "@id": "c10-quote-0",
      "@type": "Item",
      "content": "Soil looseness is harder to dismiss"
    },
    {
      "@id": "c12-quote-0",
      "@type": "Item",
      "content": "roots keep the pores open and connected"
    },
    {
      "@id": "ev1-quote-0",
      "@type": "Item",
      "content": "Planted plots released 18 liters less runoff per hour than bare plots."
    },
    {
      "@id": "ev2-quote-0",
      "@type": "Item",
      "content": "On dry days, the mean difference grew to 27 liters."
    },
    {
      "@id": "ev3-quote-0",
      "@type": "Item",
      "content": "On wet days, the difference shrank to 9 liters."
    },
    {
      "@id": "ev4-quote-0",
      "@type": "Item",
      "content": "The smallest paired difference was 4 liters, and the largest was 34 liters."
    },
    {
      "@id": "ev5-quote-0",
      "@type": "Item",
      "content": "The planted plots absorbed the first part of the downpour almost entirely, and they started to release water only after about twenty minutes."
    },
    {
      "@id": "ev6-quote-0",
      "@type": "Item",
      "content": "Both kinds of plot began to release water within five minutes, because the soil in each was already close to its limit."
    },
    {
      "@id": "ev7-quote-0",
      "@type": "Item",
      "content": "the pairs with the lowest soil moisture before the downpour showed the largest differences in runoff"
    },
    {
      "@id": "ev8-quote-0",
      "@type": "Item",
      "content": "Runoff from planted plots varied more, by about twenty-five percent"
    },
    {
      "@id": "ev9-quote-0",
      "@type": "Item",
      "content": "Two planted plots with patchy cover released more water than the others, but still less than their bare partners."
    },
    {
      "@id": "s1-quote-0",
      "@type": "Item",
      "content": "We measured stormwater leaving twelve plots after a controlled downpour."
    },
    {
      "@id": "s1-quote-1",
      "@type": "Item",
      "content": "Six plots contained grasses and deep-rooted flowers."
    },
    {
      "@id": "s2-quote-0",
      "@type": "Item",
      "content": "We also took a soil moisture reading at ten centimeters depth in each plot just before the downpour started, using a handheld probe."
    },
    {
      "@id": "p1-quote-0",
      "@type": "Item",
      "content": "The rig applied the equivalent of forty millimeters of rain in one hour"
    },
    {
      "@id": "p2-quote-0",
      "@type": "Item",
      "content": "Within each pair, a coin toss decided which plot was planted."
    },
    {
      "@id": "p3-quote-0",
      "@type": "Item",
      "content": "On wet days we watered every plot the previous evening with ten millimeters of water."
    },
    {
      "@id": "p4-quote-0",
      "@type": "Item",
      "content": "We collected the runoff in buckets for one hour and weighed each bucket on a hanging scale."
    },
    {
      "@id": "p5-quote-0",
      "@type": "Item",
      "content": "The seedlings were set in the plots the spring before the test and watered by hand until they were established."
    },
    {
      "@id": "r1-quote-0",
      "@type": "Item",
      "content": "Larger field trials would be needed to estimate the effect on a neighborhood drainage system."
    },
    {
      "@id": "e5-quote-0",
      "@type": "Item",
      "content": "Planted plots released 18 liters less runoff per hour than bare plots."
    }
  ]
}
