{
  "@graph": [
    {
      "@id": "q1",
      "@type": "Question",
      "content": "Does planting reduce the water that leaves a plot during a storm of fixed size?",
      "description": [
        "q1-quote-0"
      ]
    },
    {
      "@id": "q2",
      "@type": "Question",
      "content": "Does soil moisture before the storm change the answer?",
      "description": [
        "q2-quote-0"
      ]
    },
    {
      "@id": "q3",
      "@type": "Question",
      "content": "Can a small plot experiment say anything about the drainage of a whole street?",
      "description": [
        "q3-quote-0"
      ]
    },
    {
      "@id": "q4",
      "@type": "Question",
      "content": "What happens to neighborhood-scale flooding after several years of planting?",
      "description": [
        "q4-quote-0"
      ]
    },
    {
      "@id": "c1",
      "@type": "Claim",
      "content": "Planting reduced runoff in the test plots.",
      "description": [
        "c1-quote-0"
      ]
    },
    {
      "@id": "c2",
      "@type": "Claim",
      "content": "The benefit of planting was largest where the soil was dry before the storm.",
      "description": [
        "c2-quote-0"
      ]
    },
    {
      "@id": "c3",
      "@type": "Claim",
      "content": "Deep roots and dry soil help a plot absorb rainfall.",
      "description": [
        "c3-quote-0"
      ]
    },
    {
      "@id": "c4",
      "@type": "Claim",
      "content": "The advantage disappears as soil approaches saturation.",
      "description": [
        "c4-quote-0"
      ]
    },
    {
      "@id": "c5",
      "@type": "Claim",
      "content": "A garden saturated by a long wet spell will help little in the next storm.",
      "description": [
        "c5-quote-0"
      ]
    },
    {
      "@id": "c6",
      "@type": "Claim",
      "content": "Whether rain gardens reduce flooding across a neighborhood is still open.",
      "description": [
        "c6-quote-0"
      ]
    },
    {
      "@id": "c7",
      "@type": "Claim",
      "content": "A two-meter plot cannot stand in for a street.",
      "description": [
        "c7-quote-0"
      ]
    },
    {
      "@id": "c8",
      "@type": "Claim",
      "content": "The benefit may grow as plantings mature.",
      "description": [
        "c8-quote-0"
      ]
    },
    {
      "@id": "c9",
      "@type": "Claim",
      "content": "Leaf interception probably played only a small part.",
      "description": [
        "c9-quote-0"
      ]
    },
    {
      "@id": "c10",
      "@type": "Claim",
      "content": "Planted soil may have been looser to begin with.",
      "description": [
        "c10-quote-0"
      ]
    },
    {
      "@id": "c11",
      "@type": "Claim",
      "content": "Thinner plant cover went with more variable runoff from planted plots.",
      "description": []
    },
    {
      "@id": "c12",
      "@type": "Claim",
      "content": "Roots keep soil pores open and connected.",
      "description": [
        "c12-quote-0"
      ]
    },
    {
      "@id": "ev1",
      "@type": "Evidence",
      "content": "Planted plots released 18 liters less runoff per hour than bare plots.",
      "description": [
        "ev1-quote-0"
      ]
    },
    {
      "@id": "ev2",
      "@type": "Evidence",
      "content": "On dry days the mean difference was 27 liters.",
      "description": [
        "ev2-quote-0"
      ]
    },
    {
      "@id": "ev3",
      "@type": "Evidence",
      "content": "On wet days the mean difference was 9 liters.",
      "description": [
        "ev3-quote-0"
      ]
    },
    {
      "@id": "ev4",
      "@type": "Evidence",
      "content": "Pairwise differences ranged from 4 to 34 liters, always favoring planted plots.",
      "description": [
        "ev4-quote-0"
      ]
    },
    {
      "@id": "ev5",
      "@type": "Evidence",
      "content": "On dry days planted plots released almost no water for about twenty minutes.",
      "description": [
        "ev5-quote-0"
      ]
    },
    {
      "@id": "ev6",
      "@type": "Evidence",
      "content": "On wet days both kinds of plot released water within five minutes.",
      "description": [
        "ev6-quote-0"
      ]
    },
    {
      "@id": "ev7",
      "@type": "Evidence",
      "content": "Pairs with the driest soil showed the largest differences.",
      "description": [
        "ev7-quote-0"
      ]
    },
    {
      "@id": "ev8",
      "@type": "Evidence",
      "content": "Planted-plot runoff varied about 25 percent, bare-plot runoff about 15 percent.",
      "description": [
        "ev8-quote-0"
      ]
    },
    {
      "@id": "ev9",
      "@type": "Evidence",
      "content": "Two patchy planted plots released more than the others but less than their bare partners.",
      "description": [
        "ev9-quote-0"
      ]
    },
    {
      "@id": "s1",
      "@type": "Study",
      "content": "Paired plot experiment: twelve plots, six planted and six bare, under a one-hour simulated downpour.",
      "description": [
        "s1-quote-0",
        "s1-quote-1"
      ]
    },
    {
      "@id": "s2",
      "@type": "Study",
      "content": "Soil moisture readings at ten centimeters depth before each downpour.",
      "description": [
        "s2-quote-0"
      ]
    },
    {
      "@id": "p1",
      "@type": "Protocol",
      "content": "Sprinkler rig delivering 40 millimeters in one hour, checked with catch cups.",
      "description": [
        "p1-quote-0"
      ]
    },
    {
      "@id": "p2",
      "@type": "Protocol",
      "content": "Plots paired by position, with a coin toss deciding which was planted.",
      "description": [
        "p2-quote-0"
      ]
    },
    {
      "@id": "p3",
      "@type": "Protocol",
      "content": "Dry days after five days without rain; wet days after ten millimeters the evening before.",
      "description": [
        "p3-quote-0"
      ]
    },
    {
      "@id": "p4",
      "@type": "Protocol",
      "content": "Runoff collected in buckets for one hour and weighed.",
      "description": [
        "p4-quote-0"
      ]
    },
    {
      "@id": "p5",
      "@type": "Protocol",
      "content": "Seedlings set the spring before the test and watered by hand until established.",
      "description": [
        "p5-quote-0"
      ]
    },
    {
      "@id": "r1",
      "@type": "Request",
      "content": "Run larger and longer field trials of rain gardens.",
      "description": [
        "r1-quote-0"
      ]
    },
    {
