{
  "@graph": [
    {
      "@id": "q1",
      "@type": "Question",
      "content": "What new statistical methods can detect problematic data from summary results alone?",
      "description": [
        "q1-quote-0"
      ]
    },
    {
      "@id": "q2",
      "@type": "Question",
      "content": "How prevalent is potentially problematic data in ClinicalTrials.gov?",
      "description": [
        "q2-quote-0"
      ]
    },
    {
      "@id": "q3",
      "@type": "Question",
      "content": "Has the prevalence of problematic data in ClinicalTrials.gov changed over time?",
      "description": [
        "q3-quote-0"
      ]
    },
    {
      "@id": "q4",
      "@type": "Question",
      "content": "Do study characteristics such as funding type predict the prevalence of problematic data?",
      "description": [
        "q4-quote-0"
      ]
    },
    {
      "@id": "c1",
      "@type": "Claim",
      "content": "Problematic clinical trial data undermine clinical and policy decisions.",
      "description": [
        "c1-quote-0"
      ]
    },
    {
      "@id": "c2",
      "@type": "Claim",
      "content": "Statistical detection of problematic data remains a niche field despite its large benefits.",
      "description": [
        "c2-quote-0"
      ]
    },
    {
      "@id": "c3",
      "@type": "Claim",
      "content": "How prevalent problematic data are, and how that has changed over time, is largely unknown.",
      "description": [
        "c3-quote-0",
        "c3-quote-1"
      ]
    },
    {
      "@id": "c4",
      "@type": "Claim",
      "content": "Self-reports likely underestimate the true extent of data fabrication.",
      "description": [
        "c4-quote-0"
      ]
    },
    {
      "@id": "c5",
      "@type": "Claim",
      "content": "Systematically applying detection methods would yield a prevalence estimate of problematic data.",
      "description": [
        "c5-quote-0"
      ]
    },
    {
      "@id": "c6",
      "@type": "Claim",
      "content": "Problematic data can be detected because they violate the stochasticity expected under sampling theory.",
      "description": [
        "c6-quote-0"
      ]
    },
    {
      "@id": "c7",
      "@type": "Claim",
      "content": "Aggregating across many trial locations can mask problematic data from a single site.",
      "description": [
        "c7-quote-0"
      ]
    },
    {
      "@id": "c8",
      "@type": "Claim",
      "content": "Testing all baseline measures simultaneously lowers the false-positive rate.",
      "description": [
        "c8-quote-0"
      ]
    },
    {
      "@id": "c9",
      "@type": "Claim",
      "content": "Industry-funded trials are more frequently problematic than publicly funded trials (hypothesis).",
      "description": [
        "c9-quote-0"
      ]
    },
    {
      "@id": "c10",
      "@type": "Claim",
      "content": "Detection tools may deter data fabrication.",
      "description": [
        "c10-quote-0"
      ]
    },
    {
      "@id": "c11",
      "@type": "Claim",
      "content": "The statistical detection methods would apply beyond clinical trials, for example in psychology.",
      "description": []
    },
    {
      "@id": "c12",
      "@type": "Claim",
      "content": "Detection-based estimates offer a prevalence measure free of self-report bias.",
      "description": [
        "c12-quote-0"
      ]
    },
    {
      "@id": "c13",
      "@type": "Claim",
      "content": "Statistical analysis of published summary results can expose problematic trials.",
      "description": []
    },
    {
      "@id": "c14",
      "@type": "Claim",
      "content": "ClinicalTrials.gov's standardized, start-to-finish records enable systematic meta-research.",
      "description": [
        "c14-quote-0"
      ]
    },
    {
      "@id": "c15",
      "@type": "Claim",
      "content": "More problematic data appear to be published now than a decade ago.",
      "description": [
        "c15-quote-0"
      ]
    },
    {
      "@id": "c16",
      "@type": "Claim",
      "content": "Better detection tools would serve research-integrity investigators, editors and reviewers.",
      "description": [
        "c16-quote-0"
      ]
    },
    {
      "@id": "ev1",
      "@type": "Evidence",
      "content": "After excluding problematic studies, a meta-analysis found beta-blockers increased perioperative mortality.",
      "description": [
        "ev1-quote-0"
      ]
    },
    {
      "@id": "ev2",
      "@type": "Evidence",
      "content": "About 2% of researchers admit to having fabricated data at least once.",
      "description": [
        "ev2-quote-0"
      ]
    },
    {
      "@id": "ev3",
      "@type": "Evidence",
      "content": "The Journal of Cell Biology found image manipulation in 1% of accepted manuscripts.",
      "description": [
        "ev3-quote-0"
      ]
    },
    {
      "@id": "ev4",
      "@type": "Evidence",
      "content": "Analysis of 168 Fuji trials' published summary results led to more than 100 retractions.",
      "description": [
        "ev4-quote-0",
        "ev4-quote-1"
      ]
    },
    {
      "@id": "ev5",
      "@type": "Evidence",
      "content": "Statistical tools showed the Fuji anesthesiology results were too good to be true.",
      "description": [
        "ev5-quote-0"
      ]
    },
    {
      "@id": "ev6",
      "@type": "Evidence",
      "content": "None of 138 ClinicalTrials.gov-related publications explicitly inspected problematic data.",
      "description": [
        "ev6-quote-0"
      ]
    },
    {
      "@id": "ev7",
      "@type": "Evidence",
      "content": "ClinicalTrials.gov holds over 100,000 completed trials, more than 15,000 with summary results.",
      "description": [
        "ev7-quote-0"
      ]
    },
    {
      "@id": "s1",
      "@type": "Study",
      "content": "Planned project: develop new detection methods and apply them to ClinicalTrials.gov summary results.",
      "description": [
        "s1-quote-0",
        "s1-quote-1"
      ]
    },
    {
      "@id": "s2",
      "@type": "Study",
      "content": "Simulation studies testing the validity of the new methods before applying them.",
      "description": [
        "s2-quote-0"
      ]
    },
    {
      "@id": "s3",
      "@type": "Study",
      "content": "Simonsohn's statistical detection of fabricated data in the Smeesters and Sanna cases.",
      "description": [
        "s3-quote-0"
      ]
    },
    {
      "@id": "s4",
      "@type": "Study",
      "content": "Carlisle's analysis of 168 randomised controlled trials by Fuji.",
      "description": [
        "s4-quote-0"
      ]
    },
    {
      "@id": "s5",
      "@type": "Study",
      "content": "Meta-analysis of beta-blocker trials excluding problematic studies (Bouri et al. 2014).",
      "description": [
        "s5-quote-0"
      ]
    },
    {
      "@id": "s6",
      "@type": "Study",
      "content": "Meta-analysis of surveys on research fabrication (Fanelli 2009).",
      "description": []
    },
    {
      "@id": "p1",
      "@type": "Protocol",
      "content": "Variance-of-variances test: are between-condition variances plausible under sampling fluctuation?",
      "description": [
        "p1-quote-0"
      ]
    },
    {
      "@id": "p2",
      "@type": "Protocol",
      "content": "Overall χ² test comparing expected and observed values across all baseline measures and groups.",
      "description": [
        "p2-quote-0"
      ]
    },
    {
      "@id": "p3",
      "@type": "Protocol",
      "content": "Extract and structure ClinicalTrials.gov data before the project starts.",
      "description": [
        "p3-quote-0"
      ]
    },
    {
      "@id": "r1",
      "@type": "Request",
      "content": "Implement the methods in the R package ddfab and release it freely.",
      "description": [
        "r1-quote-0"
      ]
    },
    {
      "@id": "r2",
      "@type": "Request",
      "content": "Have another researcher independently check (co-pilot) the project results.",
      "description": [
        "r2-quote-0"
      ]
    },
    {
      "@id": "sd0",
      "@type": "SourceDocument",
      "content": "Problematic trial detection in ClinicalTrials.gov",
      "description": []
    },
    {
      "@id": "sd1",
      "@type": "SourceDocument",
      "content": "Just post it: The lesson from two cases of fabricated data detected by statistics alone",
      "description": [
        "sd1-quote-0"
      ]
    },
    {
      "@id": "sd2",
      "@type": "SourceDocument",
      "content": "The analysis of 168 randomised controlled trials to test data integrity",
      "description": [
        "sd2-quote-0"
      ]
    },
    {
      "@id": "sd3",
      "@type": "SourceDocument",
      "content": "Meta-analysis of secure randomised controlled trials of β-blockade to prevent perioperative death in non-cardiac surgery",
      "description": [
        "sd3-quote-0"
      ]
    },
    {
      "@id": "sd4",
      "@type": "SourceDocument",
      "content": "How many scientists fabricate and falsify research? A systematic review and meta-analysis of survey data",
      "description": [
        "sd4-quote-0"
      ]
    },
