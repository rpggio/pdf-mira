{
  "@graph": [
    {
      "@id": "x:n0",
      "@type": "Question",
      "content": "Can the prevalence of problematic trial data be estimated from ClinicalTrials.gov summary results?",
      "description": [
        "x:n0-quote-0"
      ]
    },
    {
      "@id": "x:n1",
      "@type": "Claim",
      "content": "Problematic data in clinical trials harm patients and decisions.",
      "description": [
        "x:n1-quote-0"
      ]
    },
    {
      "@id": "x:n2",
      "@type": "Claim",
      "content": "Fabricated data tend to lack genuine stochasticity, making them statistically detectable.",
      "description": [
        "x:n2-quote-0"
      ]
    },
    {
      "@id": "x:n3",
      "@type": "Claim",
      "content": "Whether problematic data are detected depends on how the data are problematic.",
      "description": [
        "x:n3-quote-0"
      ]
    },
    {
      "@id": "x:n4",
      "@type": "Evidence",
      "content": "Severe baseline differences between randomized groups can signal fabrication or procedural error.",
      "description": [
        "x:n4-quote-0"
      ]
    },
    {
      "@id": "x:n5",
      "@type": "Evidence",
      "content": "Few researchers combine expertise in these methods with medical science.",
      "description": []
    },
    {
      "@id": "x:n6",
      "@type": "Study",
      "content": "Six-month visit developing and applying detection methods with an onsite supervisor.",
      "description": [
        "x:n6-quote-0"
      ]
    },
    {
      "@id": "x:n7",
      "@type": "Protocol",
      "content": "Postpone applying new methods until their statistical properties are investigated.",
      "description": [
        "x:n7-quote-0"
      ]
    },
