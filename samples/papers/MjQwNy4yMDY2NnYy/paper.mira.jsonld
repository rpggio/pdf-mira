      ],
      "title": "Participatory design: reflexive field notes, regular research discussions with community members, co-authorship with community participants.",
      "content": "Participatory design: reflexive field notes, regular research discussions with community members, co-authorship with community participants.\n\nParticipatory methodology for deployment and analysis.",
      "created": "2026-11-10T15:29:09.642Z",
