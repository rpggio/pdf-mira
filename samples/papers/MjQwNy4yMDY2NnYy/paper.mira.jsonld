    },
    {
      "@id": "x:n27",
      "@type": [
        "x:_schema_Protocol",
        "Protocol"
      ],
      "title": "Playground infinite canvas: insert/create discourse nodes, visually cluster, draw edges; trigger parser to generate Roam blocks specifying nodes and edges per grammar patterns.",
      "content": "Playground infinite canvas: insert/create discourse nodes, visually cluster, draw edges; trigger parser to generate Roam blocks specifying nodes and edges per grammar patterns.\n\nVisual sensemaking interface for discourse graph construction.",
