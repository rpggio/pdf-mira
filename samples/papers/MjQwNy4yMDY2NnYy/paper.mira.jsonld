    },
    {
      "@id": "x:n13",
      "@type": [
        "x:_schema_Evidence",
        "Evidence"
      ],
      "title": "Users frequently related discourse nodes via indentation and implicit conventions rather than explicit discourse relations (e.g., 'SupportedBy'), leading to sparse formal discourse edges despite dens…",
      "content": "Users frequently related discourse nodes via indentation and implicit conventions rather than explicit discourse relations (e.g., 'SupportedBy'), leading to sparse formal discourse edges despite dense informal connections.\n\nObservation from field notes and data exports.",
      "created": "2026-11-10T15:29:09.642Z",
      "modified": "2026-11-10T15:29:09.642Z",
      "creator": "x:agent",
