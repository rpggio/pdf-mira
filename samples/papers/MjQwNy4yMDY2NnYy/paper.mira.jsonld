    {
      "@id": "x:n25",
      "@type": [
        "x:_schema_Protocol",
        "Protocol"
      ],
      "title": "Node Menu authoring: select text, press hotkey, choose node type (Question, Claim, Evidence, Source) via shortcut; extension creates typed page with metadata and replaces selection with reference.",
      "content": "Node Menu authoring: select text, press hotkey, choose node type (Question, Claim, Evidence, Source) via shortcut; extension creates typed page with metadata and replaces selection with reference.\n\nIncremental formalization mechanism for discourse node creation.",
      "created": "2026-11-10T15:29:09.642Z",
      "modified": "2026-11-10T15:29:09.642Z",
      "creator": "x:agent",
      "description": "x:a-n25"
    },
    {
      "@id": "x:n26",
      "@type": [
        "x:_schema_Protocol",
        "Protocol"
      ],
      "title": "Discourse Grammar Parser: parse formal discourse relations (support, oppose, inform) from user-defined prose/outlining conventions (indentation, referencing, tags) into queryable graph edges.",
      "content": "Discourse Grammar Parser: parse formal discourse relations (support, oppose, inform) from user-defined prose/outlining conventions (indentation, referencing, tags) into queryable graph edges.\n\nMechanism for extracting discourse edges from writing practices.",
      "created": "2026-11-10T15:29:09.642Z",
      "modified": "2026-11-10T15:29:09.642Z",
      "creator": "x:agent",
