      "description": "x:a-n23"
    },
    {
      "@id": "x:n24",
      "@type": [
        "x:_schema_Protocol",
        "Protocol"
      ],
      "title": "Constructivist/interpretivist analytic approach: interleaved analysis with data collection, reflective memos, iterative coding, sensitizing concepts (boundary objects, sensemaking, infrastructure).",
      "content": "Constructivist/interpretivist analytic approach: interleaved analysis with data collection, reflective memos, iterative coding, sensitizing concepts (boundary objects, sensemaking, infrastructure).\n\nAnalytic approach for qualitative data.",
